diff --git a/Makefile b/Makefile
index 63ce43e..b7155b6 100755
--- a/Makefile
+++ b/Makefile
@@ -1624,7 +1624,9 @@ ifeq ($(ARCH), i386)
 EXTRA_CFLAGS += -mhard-float
 EXTRA_CFLAGS += -DMARK_KERNEL_PFU
 else ifeq ($(ARCH), x86_64)
-EXTRA_CFLAGS += -mhard-float
+# The x86_64 ABI is always hard float, so the flag is not needed here. It is
+# also rejected by clang ("unsupported option '-mhard-float' for target
+# 'x86_64-linux-gnu'"), and the kernel of this machine is built with clang.
 EXTRA_CFLAGS += -DMARK_KERNEL_PFU
 endif
 
@@ -1637,6 +1639,14 @@ ifeq ($(CONFIG_CUSTOMER_HUAWEI), y)
 EXTRA_CFLAGS += -DCONFIG_HUAWEI_PROC
 endif
 
+# The Linux 6.x and 7.x kernel build system does not read the EXTRA_CFLAGS
+# variable any more: the flags of an external module are the ccflags-y ones
+# (see scripts/Makefile.lib, the _c_flags variable). The assignment is done
+# here, after all the flags have been collected, so that it takes all of
+# them. The include paths are resolved by the kernel build system, where
+# $(src) is the directory of this driver.
+ccflags-y := $(EXTRA_CFLAGS)
+
 ifeq ($(CONFIG_MULTIDRV), y)
 
 ifeq ($(CONFIG_SDIO_HCI), y)
